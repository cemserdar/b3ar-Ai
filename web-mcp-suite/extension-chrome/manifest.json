{
  "manifest_version": 3,
  "name": "Web-to-MCP Multi-Agent Bridge (Chrome)",
  "version": "2.3.2",
  "description": "Chrome üzerinde Web AI arayüzlerini çoklu ajan mimarisi ve Auto-Failover ile VS Code MCP sunucusuna bağlar.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://*.google.com.tr/*",
    "https://google.com.tr/*",
    "https://aistudio.google.com/*",
    "https://chat.deepseek.com/*",
    "https://kimi.moonshot.cn/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://chatglm.cn/*",
    "https://z.ai/*",
    "https://chat.qwen.ai/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.google.com/*",
        "https://google.com/*",
        "https://*.google.com.tr/*",
        "https://google.com.tr/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://chatglm.cn/*",
        "https://z.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://huggingface.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
